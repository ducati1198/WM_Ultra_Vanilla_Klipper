#!/bin/bash
# B-041 / F-136: the Pi 400 Wi-Fi chip (brcmfmac over SDIO) can hang: the Pi keeps running, Klipper keeps running, but the Pi is
# off the network (no Fluidd, no SSH, the touchscreen loses it) until a power cycle.
# Every 30 s ping the router. 3 misses in a row: Wi-Fi off and on. Still no answer 2 min later: reload the Wi-Fi driver.
# Still none 10 min later: start over. Never reboots the Pi, never touches Klipper.
# F-136: on 2026-11-18 the radio command timed out and the driver reload failed with "Module brcmfmac is in use"
# (NetworkManager and wpa_supplicant held wlan0). The reload now stops them first, removes brcmfmac_wcc and brcmfmac,
# and when the chip still hangs it unbinds and rebinds the SDIO host. NetworkManager is always started again at the end.
# Each step is written to the system journal (journalctl -t wm-wifi-watchdog) and, when it exists, to the black box log.
# Manual use: sudo wm-wifi-watchdog --reload-now   (runs the driver reload once and exits)
# Installed by WM_Ultra_Vanilla_Klipper (installer.sh, step "Wi-Fi") as /usr/local/sbin/wm-wifi-watchdog.
LOG=/var/log/wm-blackbox/blackbox.log
note() {
    logger -t wm-wifi-watchdog "$*"
    [ -d "$(dirname "$LOG")" ] && { echo "$(date '+%F %T') WIFI-WATCHDOG $*" >> "$LOG"; sync "$LOG" 2>/dev/null; }
    return 0
}
gw() { ip route | awk '/^default/ {print $3; exit}'; }
wifi_if() { for d in /sys/class/net/*/wireless; do [ -d "$d" ] && { basename "$(dirname "$d")"; return; }; done; echo wlan0; }
wifi_off_on() {
    timeout 20 nmcli radio wifi off || note "nmcli radio wifi off did not finish (${?})"
    sleep 5
    timeout 20 nmcli radio wifi on || note "nmcli radio wifi on did not finish (${?})"
}
sdio_rebind() {   # the chip's SDIO host (for example fe300000.mmcnr): unbind and bind again
    local h drv
    h="$(basename "$(readlink -f /sys/class/net/$(wifi_if)/device/../.. 2>/dev/null)")"
    for d in /sys/bus/platform/drivers/sdhci-iproc /sys/bus/platform/drivers/mmc-bcm2835; do
        for h in $(ls "$d" 2>/dev/null | grep -E '^[0-9a-f]+\.mmcnr$'); do
            note "SDIO host $h: unbind and bind"
            echo "$h" > "$d/unbind" 2>/dev/null; sleep 2; echo "$h" > "$d/bind" 2>/dev/null; return 0
        done
    done
    note "no SDIO host found to rebind"; return 1
}
reload_driver() {
    local i
    note "stopping NetworkManager and wpa_supplicant, then reloading brcmfmac"
    timeout 30 systemctl stop NetworkManager wpa_supplicant
    ip link set "$(wifi_if)" down 2>/dev/null
    for i in 1 2 3; do
        timeout 20 modprobe -r brcmfmac_wcc brcmfmac 2>/dev/null
        lsmod | grep -q '^brcmfmac ' || break
        sleep 3
    done
    if lsmod | grep -q '^brcmfmac '; then
        note "brcmfmac is still loaded after 3 tries (the chip is hung)"
    fi
    sdio_rebind
    sleep 3
    timeout 20 modprobe brcmfmac || note "modprobe brcmfmac failed"
    sleep 5
    timeout 30 systemctl start wpa_supplicant NetworkManager
    note "NetworkManager started again; brcmfmac $(lsmod | grep -q '^brcmfmac ' && echo loaded || echo NOT loaded)"
}
if [ "${1:-}" = "--reload-now" ]; then reload_driver; exit 0; fi
GW="$(gw)"
miss=0; step=0; last=0
note "started, router ${GW:-not known yet}"
while true; do
    g="$(gw)"; [ -n "$g" ] && GW="$g"
    if [ -n "$GW" ] && ping -c 1 -W 3 "$GW" >/dev/null 2>&1; then
        [ "$miss" -ge 3 ] && note "router answers again after $miss misses"
        miss=0; step=0
    elif [ -n "$GW" ]; then
        miss=$((miss+1))
        now=$(date +%s)
        if [ "$miss" -ge 3 ] && [ "$step" = 0 ]; then
            note "router $GW not answering 3 times: Wi-Fi off and on"
            wifi_off_on; step=1; last=$now
        elif [ "$step" = 1 ] && [ $((now-last)) -ge 120 ]; then
            note "still no router 2 min after the Wi-Fi restart: reloading the Wi-Fi driver brcmfmac"
            reload_driver; step=2; last=$now
        elif [ "$step" = 2 ] && [ $((now-last)) -ge 600 ]; then
            note "still no router 10 min after the driver reload: trying again (Wi-Fi off and on)"
            step=0
        fi
    fi
    sleep 30
done
